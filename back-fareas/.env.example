MAIL_PASSWORD=clave-de-aplicacion-gmail
MAIL_FROM_ADDRESS=tucorreo@unamba.edu.pe
MAIL_FROM_NAME=Fareas - Facultad de Informatica UNAMBA

DEVICE_TOKEN_SECRET=x.y.z.x

ALLOWED_EMAIL_DOMAIN=unamba.edu.pe
FRONTEND_BASE_URL=http://localhost:4200

R2_ENABLED=false
R2_ACCOUNT_ID=tu-account-id
