FAREAS_TEST_DB=postgresql+asyncpg://postgres:CLAVE@localhost:5432/fareas_test

JWT_SECRET_KEY=x.y.z
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

MODELS_DIR=models
FACE_MATCH_THRESHOLD=0.55

MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
