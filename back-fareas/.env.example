APP_NAME=Fareas API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:4200

DATABASE_URL=postgresql+asyncpg://postgres:CLAVE@localhost:5432/fareas
FAREAS_TEST_DB=postgresql+asyncpg://postgres:CLAVE@localhost:5432/fareas_test

JWT_SECRET_KEY=x.y.z
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

MODELS_DIR=models
# RF-20: umbral de similitud coseno. Calibrado en el Bloque 5:
# misma persona (multi-pose) >= 0.55 | impostores < 0.35
FACE_MATCH_THRESHOLD=0.55

MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tucorreo@unamba.edu.pe
MAIL_PASSWORD=clave-de-aplicacion-gmail
MAIL_FROM_ADDRESS=tucorreo@unamba.edu.pe
MAIL_FROM_NAME=Fareas - Facultad de Informatica UNAMBA

DEVICE_TOKEN_SECRET=x.y.z.x
